# Configuración de DESARROLLO LOCAL. Copiar a .env (scripts/setup.sh lo hace solo).
# Compose y Laravel leen este mismo archivo. Si un valor tiene "$", hay que escribirlo como "$$".
# Ningún valor de este archivo es un secreto real: producción configura sus variables en Laravel Cloud.

APP_NAME=Sportiva
APP_ENV=local
APP_KEY=
# Solo en local. Fuera de local, APP_DEBUG tiene que ser false.
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
SANCTUM_TOKEN_PREFIX=sportiva_
SANCTUM_PRE_TENANT_TTL=15
SANCTUM_TENANT_TTL=480
SANCTUM_PLATFORM_TTL=480
# Credenciales HTTP Basic de /api/docs. Solo se usan en staging: en local la documentación es
# abierta y en producción está desactivada. Dejar vacías acá; en staging se cargan en Laravel Cloud.
API_DOCS_USERNAME=
API_DOCS_PASSWORD=
# Puerto del host para la API (siempre en 127.0.0.1).
APP_PORT=8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base CENTRAL de la plataforma. Las bases de los clubes van por la conexión "tenant" (futuro),
# ver docs/arquitectura-multi-tenant.md.
DB_CONNECTION=mysql
# Nombre del servicio de Compose, no localhost.
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sportiva_platform
DB_USERNAME=sportiva
# Contraseña solo para desarrollo local; MySQL no se expone fuera de la máquina.
DB_PASSWORD=sportiva_dev_password
# La base de tests (sportiva_testing) es fija: la crea docker/mysql/init/01-testing-db.sh y la usa phpunit.xml.
# Puerto del host para compose.override.yaml (opcional).
DB_FORWARD_PORT=3310

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Documentos de los clubes (apto médico, fotos): privado. En producción, s3.
DOCUMENTS_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
